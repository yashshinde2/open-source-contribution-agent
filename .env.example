# GitHub Access Token (Recommended to avoid GitHub API rate limits)
GITHUB_TOKEN=your_github_personal_access_token_here

# Telegram Bot Credentials (Required if notification_channel is "telegram")
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Discord Webhook URL (Required if notification_channel is "discord")
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# Optional: LLM API Key (For AI-powered scoring; omit to use zero-cost Heuristic Engine)
GEMINI_API_KEY=your_gemini_api_key_here
